{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "server=(localdb)\\MSSQLLocalDB;database=ZooVerviers;integrated security=true;trust server certificate=true"
  },
  "Jwt": { //  Plus tard, on rangera les infos dans un endroit réellement secret car ce fichier sera publié sur Git
    "Key": "Un texte secret qui doit avoir une longueur minimale pour fonctionner.",
    "Issuer": "Demo JWT API", //  On peut les utiliser pour s'assurer que personne n'ai pu passer entre les filets
    "Audience": "Demo JWT Client" //  en s'assurant que les tokens aient été générés convenablement, mais ce n'est pas spécialement la norme
  }
}
